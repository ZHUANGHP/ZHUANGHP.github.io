source "https://rubygems.org"

# 锁定 Jekyll 版本（可选，但推荐）
gem "jekyll", "~> 4.3"

# 使用 minimal-mistakes 主题
gem "minimal-mistakes-jekyll", "~> 4.26"

# 显式列出主题依赖的插件（GitHub Actions 不会自动加载它们）
group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-gist"
  gem "jekyll-feed"
  gem "jekyll-include-cache"
end